# /etc/emhub.env  (chmod 600, owned by root)
# The address the hub is reached on.
HUB_PUBLIC_URL=https://hub.example.org
# Older addresses the dashboard is still opened on, comma-separated (admin requests from them are accepted)
HUB_EXTRA_ORIGINS=
HUB_PORT=8080
HUB_DB=/var/lib/emhub/hub.db
# Comma-separated; the Android and web apps send one of these in X-App-Key.
HUB_APP_KEYS=change-me
# First admin, created only when the database is empty.
HUB_BOOTSTRAP_USER=admin
HUB_BOOTSTRAP_PASSWORD=change-me
# Timetables (planner, boards, stop lists): GTFS feeds downloaded nightly at 04:30 into this folder.
# The feed list is edited in the dashboard (Timetable); HUB_GTFS_FEEDS is only its starting value.
# HUB_TIMETABLE=off skips loading them (about 300 MB of RAM once a day has been planned).
HUB_GTFS_DIR=/var/lib/emhub/gtfs
#HUB_GTFS_FEEDS=sad-zvolen-as,sad-lucenec-as,...
#HUB_GTFS_URL=https://transiq.xhyrom.dev/gtfs/sk/{}.zip
# A feed source tried before HUB_GTFS_URL ("{}" is the feed's name); empty: HUB_GTFS_URL only.
#HUB_CIS_URL=

# Everything below is only the starting value: admins change email and Authentik
# settings in the dashboard (Settings), which then override these.

# Email. HUB_SMTP_SECURITY: none | starttls | ssl
HUB_ADMIN_EMAIL=
HUB_MAIL_FROM=Plan&Ride <noreply@example.org>
HUB_MAIL_REPLY_TO=
HUB_SMTP_HOST=localhost
HUB_SMTP_PORT=25
HUB_SMTP_USER=
HUB_SMTP_PASS=
HUB_SMTP_SECURITY=none

# Authentik (OIDC). Issuer = https://<authentik>/application/o/<app-slug>
# Redirect URI to register in Authentik: https://hub.example.org/auth/oidc/callback
HUB_OIDC_ISSUER=
HUB_OIDC_CLIENT_ID=
HUB_OIDC_CLIENT_SECRET=
HUB_OIDC_LABEL=Authentik
# Roles from Authentik groups, usually set in Settings. One rule per line: group = admin, group = read-only, group = bugs:rw map:r
HUB_OIDC_ROLE_MAP=
